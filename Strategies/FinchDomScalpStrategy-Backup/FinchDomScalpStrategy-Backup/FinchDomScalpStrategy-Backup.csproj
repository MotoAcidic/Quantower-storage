<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!--
    FROZEN BACKUP, created 2026-10-04 — an exact snapshot of finchDomScalpStrategy.csproj's own
    source, taken right before adding the market-structure entry gate (the "already broken
    structure" filter built on SwingTracker's LastSwingHigh/LastSwingLow). Renamed throughout
    (AssemblyName/RootNamespace/class name/StrategyTag/display Name/OutputPath/port) so Quantower
    loads this as a genuinely separate script, never colliding with the live strategy's own
    identity or deployed folder. Load this one back up if the structure-filter experiment on the
    live strategy doesn't work out.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Platforms>AnyCPU</Platforms>
    <AlgoType>Strategy</AlgoType>
    <AssemblyName>FinchDomScalpStrategy-Backup</AssemblyName>
    <RootNamespace>FinchDomScalpStrategyBackup</RootNamespace>
    <StartAction>Program</StartAction>
    <!-- CONFIRM against whatever's under C:\Quantower\TradingPlatform\ on the machine actually
         building; Quantower auto-updates itself with no warning (see Quantower-storage/CLAUDE.md). -->
    <StartProgram>C:\Quantower\TradingPlatform\v1.147.4\Console.StarterNew.exe</StartProgram>
    <StartArguments>--address 127.0.0.1 --port 62745</StartArguments>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
     <OutputPath>C:\Quantower\Settings\Scripts\Strategies\FinchDomScalpStrategy-Backup</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
     <OutputPath>C:\Quantower\Settings\Scripts\Strategies\FinchDomScalpStrategy-Backup</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="TradingPlatform.BusinessLayer">
      <HintPath>C:\Quantower\TradingPlatform\v1.147.5\bin\TradingPlatform.BusinessLayer.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!--
      Compiled IN, not referenced — same reasoning as the live finchDomScalpStrategy.csproj's own
      copy of this comment (Quantower's Assembly.Load(bytes) caches by FullName; a shared DLL would
      collide between script folders). This backup's own copy is a frozen snapshot as of THIS
      file's own last build, same as the live strategy's.
    -->
    <Compile Include="..\..\..\Indicators\Finch-Lite\src\Finch.Lite.Indicator\Bar.cs" />
    <Compile Include="..\..\..\Indicators\Finch-Lite\src\Finch.Lite.Indicator\RestingOrderEngine.cs" />
    <Compile Include="..\..\..\Indicators\Finch-Lite\src\Finch.Lite.Indicator\FairValueGapEngine.cs" />
    <Compile Include="..\..\..\Indicators\Finch-Lite\src\Finch.Lite.Indicator\PocEngine.cs" />
  </ItemGroup>
</Project>
