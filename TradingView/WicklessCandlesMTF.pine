// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//
// Wickless Candles (MTF) — marks candles with (within a small tolerance) no wick on one side, on
// the chart's own native timeframe AND on four higher timeframes (5m/15m/1H/4H) watched at the
// same time. Operator's own ask (2026-10-22): "I need a tradingview indicator that will draw a
// line and label the chart time frame that has a wickless candle body on it," then: "I want it to
// mark out all wickless candles from the 1min 5min 15min 1hr and 4hr."
//
// HISTORY, 2026-10-23: the original build watched five FIXED timeframes via `request.security`,
// which needed the "offset by one bar inside a lookahead_on request" idiom to avoid repainting.
// Several rounds of bug reports (a visibly-wicked candle flagged wickless; a level that should
// have cleared not clearing) never got fully root-caused despite a debug-OHLC mode added to chase
// them. Operator's own call: "just read the actual bars them selves instead of the data read the
// bar and if the bar doesnt have a wick then mark it not that hard." Correct call — the script was
// rewritten to read the chart's own native series directly (no request.security at all), which
// has been solid since. Operator then asked for the multi-timeframe convenience back: "being on
// the 1min chart and seeing the 5min lines was nice."
//
// HOW THE HIGHER TIMEFRAMES WORK NOW, WITHOUT `request.security`: rather than fetching 5m/15m/1H/4H
// data from Pine's own higher-timeframe machinery (the thing that kept producing mismatched data),
// each one is assembled BY HAND from the chart's own native, already-proven-reliable closed bars —
// same "just read the actual bars" principle, just applied to build the higher-timeframe candles
// too instead of fetching them pre-built. For each watched period, a running accumulator tracks its
// own open/high/low/close across every native bar that falls inside the current UTC-aligned
// boundary (`time - (time % periodMs)`); the instant a native bar's boundary differs from the
// accumulator's own, the accumulator holds one COMPLETE, correctly-closed higher-timeframe candle,
// evaluated for wickless-ness right then before starting a fresh accumulator for the new boundary.
// No request.security, no lookahead, no repaint-avoidance trickery — only the same native OHLC
// values already in use for the chart's own timeframe.
//
// REQUIREMENT, stated plainly: this self-aggregation only produces a correct higher-timeframe
// candle when the CHART's own timeframe evenly divides into it (1-minute chart building 5m candles
// from five native 1-minute bars = correct; a 7-minute chart cannot cleanly build 5m candles at
// all). Each watched period is automatically skipped whenever it isn't strictly larger than the
// chart's own timeframe — matches the operator's own stated primary use (the 1-minute chart, which
// divides cleanly into all four of 5m/15m/1H/4H).
//
// DEFINITION — same tolerance-based rule already proven in the operator's own Quantower work
// (srmAutoStrategy / WicklessLevelEngine): a candle's body-extreme sits within a small tick
// tolerance of the bar's own high/low on that side. A top-wickless candle (no upper wick) marks
// its HIGH as a level; a bottom-wickless candle (no lower wick) marks its LOW.
//
// UNTESTED-UNTIL-TOUCHED: each level extends forward until a LATER bar's range trades through that
// exact price (high >= level and low <= level — a wick touching it counts, same as a resting
// take-profit order would fill there), checked every bar against the CHART's own live high/low
// regardless of which timeframe produced the level. By default a tested level is DELETED outright
// (`showTestedInput` off) rather than kept on the chart piling up into clutter over a session.
//
// LINES AND LABELS ARE PINNED INTO THE BLANK SPACE PAST THE LAST CANDLE (`last_bar_time + N *
// barInterval`, N staggered per timeframe) — same convention as the PWL/PDL/PML labels in the
// operator's own smc.pine, label text growing LEFTWARD (`label.style_label_left`) from that fixed
// right-side anchor so it never runs off the edge.
//
//@version=6
indicator('Wickless Candles (MTF)', shorttitle = 'Wickless MTF', overlay = true, max_lines_count = 500, max_labels_count = 500)

// === Inputs ===
tolTicksInput = input.float(1.0, 'Wick tolerance (ticks, 0 = no wick at all)', minval = 0, step = 0.25, group = 'Detection')
debugRawOhlc  = input.bool(false, 'Debug: show raw O/H/L/C in label', group = 'Detection', tooltip = 'Shows the exact open/high/low/close used for the candle, for comparison against what the chart (or, for the higher timeframes, the real published candle) shows on hover.')

showNative = input.bool(true, 'Current chart timeframe', group = 'Timeframes', inline = 'tfN')
colorNativeH = input.color(color.new(#ff6d00, 0), '', group = 'Timeframes', inline = 'tfN')
show5m  = input.bool(true, '5 minute',  group = 'Timeframes', inline = 'tf5')
color5m = input.color(color.new(#d500f9, 0), '', group = 'Timeframes', inline = 'tf5')
show15m = input.bool(true, '15 minute', group = 'Timeframes', inline = 'tf15')
color15m = input.color(color.new(#2979ff, 0), '', group = 'Timeframes', inline = 'tf15')
show1h  = input.bool(true, '1 hour',    group = 'Timeframes', inline = 'tf1h')
color1h = input.color(color.new(#00c853, 0), '', group = 'Timeframes', inline = 'tf1h')
show4h  = input.bool(true, '4 hour',    group = 'Timeframes', inline = 'tf4h')
color4h = input.color(color.new(#ffd600, 0), '', group = 'Timeframes', inline = 'tf4h')

maxLevelsPerTf  = input.int(15, 'Max UNTESTED levels kept per timeframe', minval = 2, maxval = 80, group = 'Style', tooltip = 'Bounds how many still-untested levels each timeframe tracks at once.')
lineWidthInput  = input.int(1, 'Line width', minval = 1, maxval = 4, group = 'Style')
showLabels      = input.bool(true, 'Show labels', group = 'Style')
showTestedInput = input.bool(false, 'Show tested levels (unchecked = delete them)', group = 'Style', tooltip = 'Off by default — a tested level is simply removed the instant price trades through it, instead of staying on the chart dimmed forever.')
rightOffsetBars  = input.int(3, 'Right-edge offset (bars past the last candle)', minval = 0, maxval = 100, group = 'Style', tooltip = 'How far into the blank space past the last candle the lines/labels are pinned — same convention as the PWL/PDL/PML labels in smc.pine. Kept small by default so it stays close even at a tight zoom.')
labelStaggerBars = input.int(10, 'Label horizontal stagger (bars per timeframe)', minval = 0, maxval = 60, group = 'Style', tooltip = 'Each timeframe gets this many extra bars further right than the one before it, so two timeframes with a level at nearly the same price (very plausible — a 1m wickless candle is often literally one of the five 1-minute candles inside a 5m bar) render as two distinguishable labels instead of one overlapping blob.')

tolerance = tolTicksInput * syminfo.mintick
chartPeriodMs = timeframe.in_seconds(timeframe.period) * 1000

// Friendly tag for the native timeframe's own label text — falls back to the raw Pine period
// string (e.g. "D", "W") for anything outside the common intraday set.
nativeTag = switch timeframe.period
    '1'   => '1m'
    '5'   => '5m'
    '15'  => '15m'
    '60'  => '1H'
    '240' => '4H'
    =>       timeframe.period

// === Native (current chart) timeframe — reads the chart's own series directly, no aggregation ===
var line[]   nTopLines  = array.new_line()
var float[]  nTopLevels = array.new_float()
var label[]  nTopLabels = array.new_label()
var string[] nTopTexts  = array.new_string()
var line[]   nBotLines  = array.new_line()
var float[]  nBotLevels = array.new_float()
var label[]  nBotLabels = array.new_label()
var string[] nBotTexts  = array.new_string()

nativeLabelX = last_bar_time + (rightOffsetBars * (time - time[1]))

if showNative
    if array.size(nTopLines) > 0
        for i = array.size(nTopLines) - 1 to 0
            lvl = array.get(nTopLevels, i)
            if high >= lvl and low <= lvl
                ln  = array.get(nTopLines, i)
                lbl = array.get(nTopLabels, i)
                if showTestedInput
                    base = array.get(nTopTexts, i)
                    line.set_x2(ln, nativeLabelX)
                    line.set_color(ln, color.new(colorNativeH, 75))
                    line.set_style(ln, line.style_dotted)
                    if not na(lbl)
                        label.set_x(lbl, nativeLabelX)
                        label.set_text(lbl, base + ' (tested)')
                else
                    line.delete(ln)
                    if not na(lbl)
                        label.delete(lbl)
                array.remove(nTopLines, i)
                array.remove(nTopLevels, i)
                array.remove(nTopLabels, i)
                array.remove(nTopTexts, i)
            else
                line.set_x2(array.get(nTopLines, i), nativeLabelX)

    if array.size(nBotLines) > 0
        for i = array.size(nBotLines) - 1 to 0
            lvl = array.get(nBotLevels, i)
            if high >= lvl and low <= lvl
                ln  = array.get(nBotLines, i)
                lbl = array.get(nBotLabels, i)
                if showTestedInput
                    base = array.get(nBotTexts, i)
                    line.set_x2(ln, nativeLabelX)
                    line.set_color(ln, color.new(colorNativeH, 75))
                    line.set_style(ln, line.style_dotted)
                    if not na(lbl)
                        label.set_x(lbl, nativeLabelX)
                        label.set_text(lbl, base + ' (tested)')
                else
                    line.delete(ln)
                    if not na(lbl)
                        label.delete(lbl)
                array.remove(nBotLines, i)
                array.remove(nBotLevels, i)
                array.remove(nBotLabels, i)
                array.remove(nBotTexts, i)
            else
                line.set_x2(array.get(nBotLines, i), nativeLabelX)

    if barstate.isconfirmed
        nBodyHigh = math.max(open, close)
        nBodyLow  = math.min(open, close)
        nDebugTxt = debugRawOhlc
          ? ' [o=' + str.tostring(open, format.mintick) + ' h=' + str.tostring(high, format.mintick) + ' l=' + str.tostring(low, format.mintick) + ' c=' + str.tostring(close, format.mintick) + ']'
          : ''

        if (high - nBodyHigh) <= tolerance
            nBaseTxt = nativeTag + ' WLS H' + nDebugTxt
            nNewLine = line.new(time, high, nativeLabelX, high, xloc = xloc.bar_time, color = colorNativeH, width = lineWidthInput, style = line.style_solid)
            label nNewLabel = na
            if showLabels
                nNewLabel := label.new(nativeLabelX, high, nBaseTxt, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = colorNativeH, size = size.small)
            array.push(nTopLines, nNewLine)
            array.push(nTopLevels, high)
            array.push(nTopLabels, nNewLabel)
            array.push(nTopTexts, nBaseTxt)
            if array.size(nTopLines) > maxLevelsPerTf
                oldLine  = array.shift(nTopLines)
                array.shift(nTopLevels)
                oldLabel = array.shift(nTopLabels)
                array.shift(nTopTexts)
                line.delete(oldLine)
                if not na(oldLabel)
                    label.delete(oldLabel)

        if (nBodyLow - low) <= tolerance
            nBaseTxt = nativeTag + ' WLS L' + nDebugTxt
            nNewLine = line.new(time, low, nativeLabelX, low, xloc = xloc.bar_time, color = colorNativeH, width = lineWidthInput, style = line.style_solid)
            label nNewLabel = na
            if showLabels
                nNewLabel := label.new(nativeLabelX, low, nBaseTxt, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = colorNativeH, size = size.small)
            array.push(nBotLines, nNewLine)
            array.push(nBotLevels, low)
            array.push(nBotLabels, nNewLabel)
            array.push(nBotTexts, nBaseTxt)
            if array.size(nBotLines) > maxLevelsPerTf
                oldLine  = array.shift(nBotLines)
                array.shift(nBotLevels)
                oldLabel = array.shift(nBotLabels)
                array.shift(nBotTexts)
                line.delete(oldLine)
                if not na(oldLabel)
                    label.delete(oldLabel)

// === Higher timeframes — self-aggregated from the chart's own native closed bars, no request.security ===

// @type   One watched higher timeframe: its own accumulator (building the CURRENT, still-forming
//         higher-timeframe candle out of native bars) plus its own tracked untested levels.
type tfState
    color    col
    int      periodMs
    string   tag
    int      boundary = na
    float    accO = na
    float    accH = na
    float    accL = na
    float    accC = na
    bool     accValid = false
    line[]   topLines
    float[]  topLevels
    label[]  topLabels
    string[] topTexts
    line[]   botLines
    float[]  botLevels
    label[]  botLabels
    string[] botTexts

// @function   `type` field defaults in Pine must be compile-time constants, not function calls
//              like array.new_line(), so the array fields are constructed explicitly here.
newTfState(color c, int periodMs, string tag) =>
    tfState.new(c, periodMs, tag, na, na, na, na, na, false, array.new_line(), array.new_float(), array.new_label(), array.new_string(), array.new_line(), array.new_float(), array.new_label(), array.new_string())

var tfState state5m  = newTfState(color5m,  5  * 60 * 1000, '5m')
var tfState state15m = newTfState(color15m, 15 * 60 * 1000, '15m')
var tfState state1h  = newTfState(color1h,  60 * 60 * 1000, '1H')
var tfState state4h  = newTfState(color4h,  240 * 60 * 1000, '4H')

// @function   Mitigation (every bar, against the chart's own live high/low) + accumulator update
//              and wickless evaluation (only on a confirmed native bar) for one watched timeframe.
//              Skips entirely whenever this timeframe isn't strictly larger than the chart's own —
//              self-aggregation only produces a correct candle when the chart's own bars evenly
//              divide into it.
processHtf(tfState st, bool enabled, int slotIndex) =>
    if enabled and st.periodMs > chartPeriodMs
        labelX = last_bar_time + ((rightOffsetBars + ((slotIndex + 1) * labelStaggerBars)) * (time - time[1]))

        if array.size(st.topLines) > 0
            for i = array.size(st.topLines) - 1 to 0
                lvl = array.get(st.topLevels, i)
                if high >= lvl and low <= lvl
                    ln   = array.get(st.topLines, i)
                    lbl  = array.get(st.topLabels, i)
                    if showTestedInput
                        base = array.get(st.topTexts, i)
                        line.set_x2(ln, labelX)
                        line.set_color(ln, color.new(st.col, 75))
                        line.set_style(ln, line.style_dotted)
                        if not na(lbl)
                            label.set_x(lbl, labelX)
                            label.set_text(lbl, base + ' (tested)')
                    else
                        line.delete(ln)
                        if not na(lbl)
                            label.delete(lbl)
                    array.remove(st.topLines, i)
                    array.remove(st.topLevels, i)
                    array.remove(st.topLabels, i)
                    array.remove(st.topTexts, i)
                else
                    line.set_x2(array.get(st.topLines, i), labelX)

        if array.size(st.botLines) > 0
            for i = array.size(st.botLines) - 1 to 0
                lvl = array.get(st.botLevels, i)
                if high >= lvl and low <= lvl
                    ln   = array.get(st.botLines, i)
                    lbl  = array.get(st.botLabels, i)
                    if showTestedInput
                        base = array.get(st.botTexts, i)
                        line.set_x2(ln, labelX)
                        line.set_color(ln, color.new(st.col, 75))
                        line.set_style(ln, line.style_dotted)
                        if not na(lbl)
                            label.set_x(lbl, labelX)
                            label.set_text(lbl, base + ' (tested)')
                    else
                        line.delete(ln)
                        if not na(lbl)
                            label.delete(lbl)
                    array.remove(st.botLines, i)
                    array.remove(st.botLevels, i)
                    array.remove(st.botLabels, i)
                    array.remove(st.botTexts, i)
                else
                    line.set_x2(array.get(st.botLines, i), labelX)

        if barstate.isconfirmed
            boundary = time - (time % st.periodMs)

            // The accumulator holds a COMPLETE higher-timeframe candle the instant we roll into a
            // new boundary — evaluate it now, before resetting for the new one.
            if st.accValid and boundary != st.boundary
                hBodyHigh = math.max(st.accO, st.accC)
                hBodyLow  = math.min(st.accO, st.accC)
                hDebugTxt = debugRawOhlc
                  ? ' [o=' + str.tostring(st.accO, format.mintick) + ' h=' + str.tostring(st.accH, format.mintick) + ' l=' + str.tostring(st.accL, format.mintick) + ' c=' + str.tostring(st.accC, format.mintick) + ']'
                  : ''

                if (st.accH - hBodyHigh) <= tolerance
                    hBaseTxt = st.tag + ' WLS H' + hDebugTxt
                    hNewLine = line.new(st.boundary, st.accH, labelX, st.accH, xloc = xloc.bar_time, color = st.col, width = lineWidthInput, style = line.style_solid)
                    label hNewLabel = na
                    if showLabels
                        hNewLabel := label.new(labelX, st.accH, hBaseTxt, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = st.col, size = size.small)
                    array.push(st.topLines, hNewLine)
                    array.push(st.topLevels, st.accH)
                    array.push(st.topLabels, hNewLabel)
                    array.push(st.topTexts, hBaseTxt)
                    if array.size(st.topLines) > maxLevelsPerTf
                        oldLine  = array.shift(st.topLines)
                        array.shift(st.topLevels)
                        oldLabel = array.shift(st.topLabels)
                        array.shift(st.topTexts)
                        line.delete(oldLine)
                        if not na(oldLabel)
                            label.delete(oldLabel)

                if (hBodyLow - st.accL) <= tolerance
                    hBaseTxt = st.tag + ' WLS L' + hDebugTxt
                    hNewLine = line.new(st.boundary, st.accL, labelX, st.accL, xloc = xloc.bar_time, color = st.col, width = lineWidthInput, style = line.style_solid)
                    label hNewLabel = na
                    if showLabels
                        hNewLabel := label.new(labelX, st.accL, hBaseTxt, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = st.col, size = size.small)
                    array.push(st.botLines, hNewLine)
                    array.push(st.botLevels, st.accL)
                    array.push(st.botLabels, hNewLabel)
                    array.push(st.botTexts, hBaseTxt)
                    if array.size(st.botLines) > maxLevelsPerTf
                        oldLine  = array.shift(st.botLines)
                        array.shift(st.botLevels)
                        oldLabel = array.shift(st.botLabels)
                        array.shift(st.botTexts)
                        line.delete(oldLine)
                        if not na(oldLabel)
                            label.delete(oldLabel)

            if not st.accValid or boundary != st.boundary
                // Starting a fresh higher-timeframe candle at this native bar. accC assigned last
                // in both branches so the if/else's own (unused, but type-checked) result type
                // matches — Pine errors on bool-vs-float otherwise, even when the value is discarded.
                st.boundary := boundary
                st.accValid := true
                st.accO := open
                st.accH := high
                st.accL := low
                st.accC := close
            else
                // Still inside the same higher-timeframe candle — extend it.
                st.accH := math.max(st.accH, high)
                st.accL := math.min(st.accL, low)
                st.accC := close

processHtf(state5m,  show5m,  0)
processHtf(state15m, show15m, 1)
processHtf(state1h,  show1h,  2)
processHtf(state4h,  show4h,  3)

// === Alerts ===
alertcondition(showNative and barstate.isconfirmed and (high - math.max(open, close)) <= tolerance, title = 'Wickless Top formed (native)', message = 'Wickless top candle formed (no upper wick) on the chart\'s own timeframe.')
alertcondition(showNative and barstate.isconfirmed and (math.min(open, close) - low) <= tolerance, title = 'Wickless Bottom formed (native)', message = 'Wickless bottom candle formed (no lower wick) on the chart\'s own timeframe.')
