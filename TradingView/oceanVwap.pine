//@version=6
// ════════════════════════════════════════════════════════════════════════════
//  Ocean σ-VWAP — Session-Anchored VWAP + 3 Volume-Weighted Deviation Bands
//  • True volume-weighted σ (not price stdev) — matches Sierra/ATAS-style VWAP bands
//  • Resets on any session you define (presets in ET, or fully custom time + TZ)
//  • Intrabar precision mode: rebuilds VWAP/σ from 1m data on higher timeframes
//  • Prior-session VWAP & bands carried as "naked" reference levels
//  • Live σ-position (z), session z-extremes, zone readout, rejection signals, alerts
// ════════════════════════════════════════════════════════════════════════════
indicator("Ocean σ-VWAP | Session Bands", shorttitle = "σ-VWAP", overlay = true, max_labels_count = 50)

// ───────────── Session / Reset ─────────────
const string G_S = "Session / Reset"
string preset   = input.string("RTH 09:30-16:00 ET", "Session", options = ["RTH 09:30-16:00 ET", "Globex 18:00-17:00 ET", "Asia 18:00-03:00 ET", "London 03:00-09:30 ET", "Custom"], group = G_S, tooltip = "Presets are fixed to New York time. Pick 'Custom' to set your own window and timezone.")
string custSess = input.session("0930-1600", "Custom session time", group = G_S, tooltip = "Start-End (24h). Overnight windows like 1800-0300 are fine. Needs at least a 1-bar gap between sessions to detect the reset.")
string custTz   = input.string("America/New_York", "Custom timezone", options = ["America/New_York", "America/Chicago", "America/Los_Angeles", "Europe/London", "Europe/Berlin", "Asia/Tokyo", "Asia/Hong_Kong", "UTC", "Exchange"], group = G_S)
bool   extend   = input.bool(false, "Hold lines outside session", group = G_S, tooltip = "Freezes the final VWAP/bands after the session ends instead of hiding them.")

// ───────────── Calculation ─────────────
const string G_C = "Calculation"
float  src     = input.source(hlc3, "Source", group = G_C)
string bandMd  = input.string("Std Dev", "Band mode", options = ["Std Dev", "Percent"], group = G_C, tooltip = "Std Dev = volume-weighted standard deviation around VWAP (institutional standard). Percent = fixed % of VWAP per ×1.")
float  m1      = input.float(1.0, "Band multipliers  1", minval = 0.0, step = 0.25, inline = "m", group = G_C)
float  m2      = input.float(2.0, "2", minval = 0.0, step = 0.25, inline = "m", group = G_C)
float  m3      = input.float(3.0, "3", minval = 0.0, step = 0.25, inline = "m", group = G_C)
float  pctUnit = input.float(0.25, "Percent per ×1 (Percent mode)", minval = 0.01, step = 0.05, group = G_C)
bool   ltfOn   = input.bool(false, "Intrabar precision", inline = "ltf", group = G_C, tooltip = "On charts above the selected TF, rebuilds VWAP and σ from lower-timeframe bars (uses hlc3 of each sub-bar). Much more accurate σ on 5m/15m/1h charts.")
string ltf     = input.timeframe("1", "", inline = "ltf", group = G_C)
int    slopeN  = input.int(5, "VWAP slope lookback (bars)", minval = 1, group = G_C)

// ───────────── Style ─────────────
const string G_V = "Style"
string theme  = input.string("Ocean", "Color theme", options = ["Ocean", "Pulse", "Classic", "Mono", "Custom"], group = G_V, tooltip = "Ocean = teal (below/support) · copper (above/resistance) · silver neutral.\nPulse = cyan support · white resistance.\nClassic = green/red.\nMono = grayscale, VWAP stays colored.\nCustom = uses the color pickers below.")
string vColMd = input.string("Both agree", "Color VWAP by", options = ["Price vs VWAP", "VWAP slope", "Both agree"], group = G_V, tooltip = "Both agree: bull only when price > VWAP AND VWAP rising; bear when both bearish; neutral when they conflict (chop/rotation).")
color iBull = input.color(#00E676, "Custom VWAP  bull", inline = "v", group = G_V)
color iBear = input.color(#FF3D71, "bear", inline = "v", group = G_V)
color iNeut = input.color(#FFC400, "neutral", inline = "v", group = G_V)
int   vwW   = input.int(2, "VWAP width", minval = 1, maxval = 5, group = G_V)
color iU1   = input.color(#FFAB91, "Custom upper  1", inline = "u", group = G_V)
color iU2   = input.color(#FF7043, "2", inline = "u", group = G_V)
color iU3   = input.color(#E53935, "3", inline = "u", group = G_V)
color iL1   = input.color(#80DEEA, "Custom lower  1", inline = "l", group = G_V)
color iL2   = input.color(#29B6F6, "2", inline = "l", group = G_V)
color iL3   = input.color(#1E88E5, "3", inline = "l", group = G_V)

// theme resolver: Ocean, Pulse, Classic, Mono, else Custom
f_th(color oc, color pu, color cl, color mo, color cu) =>
    theme == "Ocean" ? oc : theme == "Pulse" ? pu : theme == "Classic" ? cl : theme == "Mono" ? mo : cu

color cBull = f_th(#2EC4B6, #18FFFF, #089981, #2EC4B6, iBull)
color cBear = f_th(#D08A4E, #ECEFF1, #F23645, #D08A4E, iBear)
color cNeut = f_th(#AAB4BE, #546E7A, #FFB300, #9E9E9E, iNeut)
color cU1   = f_th(#E8C3A0, #F5F5F5, #F7A8AE, #D4D4D8, iU1)
color cU2   = f_th(#D08A4E, #CFD8DC, #F23645, #A1A1AA, iU2)
color cU3   = f_th(#9A5426, #90A4AE, #A51C2A, #71717A, iU3)
color cL1   = f_th(#9EE6DE, #A7FFFF, #9ADBC8, #D4D4D8, iL1)
color cL2   = f_th(#2EC4B6, #18FFFF, #089981, #A1A1AA, iL2)
color cL3   = f_th(#167D74, #00ACC1, #056656, #71717A, iL3)
bool  fillOn = input.bool(false, "Fill bands", inline = "f", group = G_V)
int   fBase  = input.int(92, "inner transparency", minval = 60, maxval = 100, inline = "f", group = G_V)
bool  barCol = input.bool(false, "Color bars by σ-position", group = G_V)
bool  showLbl = input.bool(true, "Price labels on right edge", group = G_V)

// ───────────── Prior session ─────────────
const string G_P = "Prior Session Levels"
bool  showPV = input.bool(true, "Prior session VWAP", inline = "p", group = G_P)
bool  showPB = input.bool(false, "Prior session bands", inline = "p", group = G_P)
color cPV    = input.color(#B0BEC5, "Color", group = G_P)

// ───────────── Signals / Table ─────────────
const string G_X = "Signals / Dashboard"
bool   showSig = input.bool(true, "Band rejection signals", group = G_X, tooltip = "Fade marker when a bar wicks through the chosen band and closes back inside with an opposite-color body.")
int    sigBand = input.int(2, "Rejection band", options = [1, 2, 3], group = G_X)
bool   showTbl = input.bool(true, "Dashboard", group = G_X)
string tPosIn  = input.string("Top right", "Dashboard position", options = ["Top right", "Bottom right", "Top left", "Bottom left"], group = G_X)

// ════════════════════════════ ENGINE ════════════════════════════
string sessStr = switch preset
    "RTH 09:30-16:00 ET"    => "0930-1600"
    "Globex 18:00-17:00 ET" => "1800-1700"
    "Asia 18:00-03:00 ET"   => "1800-0300"
    "London 03:00-09:30 ET" => "0300-0930"
    => custSess
string tzStr = preset == "Custom" ? (custTz == "Exchange" ? syminfo.timezone : custTz) : "America/New_York"

bool inSess  = not na(time(timeframe.period, sessStr, tzStr))
bool newSess = inSess and not inSess[1]

// Per-bar contributions (chart bar, or summed lower-TF sub-bars)
float vRaw = na(volume) ? 1.0 : volume
float bV   = vRaw
float bPV  = src * vRaw
float bP2V = src * src * vRaw
bool  ltfActive = ltfOn and timeframe.in_seconds() > timeframe.in_seconds(ltf)
if ltfActive
    [aP, aV] = request.security_lower_tf(syminfo.tickerid, ltf, [hlc3, volume])
    if aP.size() > 0
        float tV = 0.0
        float tPV = 0.0
        float tP2V = 0.0
        for i = 0 to aP.size() - 1
            float p = aP.get(i)
            float w = nz(aV.get(i))
            if not na(p)
                tV += w
                tPV += p * w
                tP2V += p * p * w
        if tV > 0
            bV := tV
            bPV := tPV
            bP2V := tP2V

var float sV = 0.0
var float sPV = 0.0
var float sP2V = 0.0
var float vw = na
var float sd = na
var float unit = na
var float vwFirst = na
var int   barsIn = 0
var float zHi = na
var float zLo = na
var float pVW = na
var float pUnit = na

if newSess
    pVW := vw
    pUnit := unit
    sV := 0.0
    sPV := 0.0
    sP2V := 0.0
    barsIn := 0
    zHi := na
    zLo := na

if inSess
    sV += bV
    sPV += bPV
    sP2V += bP2V
    barsIn += 1
    if sV > 0
        vw := sPV / sV
        sd := math.sqrt(math.max(sP2V / sV - vw * vw, 0.0))
        unit := bandMd == "Std Dev" ? sd : vw * pctUnit / 100.0
        if barsIn == 1
            vwFirst := vw

bool  show = inSess or (extend and not na(vw))
float pv = show ? vw : na
float u1 = show ? vw + unit * m1 : na
float u2 = show ? vw + unit * m2 : na
float u3 = show ? vw + unit * m3 : na
float l1 = show ? vw - unit * m1 : na
float l2 = show ? vw - unit * m2 : na
float l3 = show ? vw - unit * m3 : na

// σ-position (in band units) + session extremes
float z = show and unit > 0 ? (close - vw) / unit : na
if inSess and unit > 0
    float zh = (high - vw) / unit
    float zl = (low - vw) / unit
    zHi := na(zHi) ? zh : math.max(zHi, zh)
    zLo := na(zLo) ? zl : math.min(zLo, zl)

// VWAP state color
float slope = barsIn > slopeN ? vw - vw[slopeN] : vw - vwFirst
bool  upPx = close > vw
bool  upSl = slope > 0
color vCol = switch vColMd
    "Price vs VWAP" => upPx ? cBull : cBear
    "VWAP slope"    => upSl ? cBull : cBear
    => upPx and upSl ? cBull : not upPx and not upSl ? cBear : cNeut

// ════════════════════════════ PLOTS ════════════════════════════
// Color = na on the reset bar so sessions never connect
pVWp = plot(pv, "VWAP", newSess ? na : vCol, vwW, plot.style_linebr)
pU1  = plot(u1, "Upper 1", newSess ? na : cU1, 1, plot.style_linebr)
pU2  = plot(u2, "Upper 2", newSess ? na : cU2, 1, plot.style_linebr)
pU3  = plot(u3, "Upper 3", newSess ? na : cU3, 2, plot.style_linebr)
pL1  = plot(l1, "Lower 1", newSess ? na : cL1, 1, plot.style_linebr)
pL2  = plot(l2, "Lower 2", newSess ? na : cL2, 1, plot.style_linebr)
pL3  = plot(l3, "Lower 3", newSess ? na : cL3, 2, plot.style_linebr)

bool fOK = fillOn and not newSess
int  t1 = fBase
int  t2 = math.max(fBase - 4, 0)
int  t3 = math.max(fBase - 8, 0)
fill(pVWp, pU1, fOK ? color.new(cU1, t1) : na, "Fill VWAP→U1")
fill(pU1, pU2, fOK ? color.new(cU2, t2) : na, "Fill U1→U2")
fill(pU2, pU3, fOK ? color.new(cU3, t3) : na, "Fill U2→U3")
fill(pVWp, pL1, fOK ? color.new(cL1, t1) : na, "Fill VWAP→L1")
fill(pL1, pL2, fOK ? color.new(cL2, t2) : na, "Fill L1→L2")
fill(pL2, pL3, fOK ? color.new(cL3, t3) : na, "Fill L2→L3")

// Prior-session reference levels (only drawn inside the current session)
bool pOK = inSess and not na(pVW)
plot(showPV and pOK ? pVW : na, "Prior VWAP", cPV, 1, plot.style_circles)
plot(showPB and pOK ? pVW + pUnit * m1 : na, "Prior +1", color.new(cU1, 40), 1, plot.style_circles)
plot(showPB and pOK ? pVW + pUnit * m2 : na, "Prior +2", color.new(cU2, 40), 1, plot.style_circles)
plot(showPB and pOK ? pVW + pUnit * m3 : na, "Prior +3", color.new(cU3, 40), 1, plot.style_circles)
plot(showPB and pOK ? pVW - pUnit * m1 : na, "Prior -1", color.new(cL1, 40), 1, plot.style_circles)
plot(showPB and pOK ? pVW - pUnit * m2 : na, "Prior -2", color.new(cL2, 40), 1, plot.style_circles)
plot(showPB and pOK ? pVW - pUnit * m3 : na, "Prior -3", color.new(cL3, 40), 1, plot.style_circles)

// Bar coloring by σ-position (gradient: lower-3 → neutral → upper-3)
color zCol = na(z) ? na : z >= 0 ? color.from_gradient(z, 0, m3, cNeut, cU3) : color.from_gradient(z, -m3, 0, cL3, cNeut)
barcolor(barCol ? zCol : na)

// ════════════════════════════ SIGNALS ════════════════════════════
float uK = sigBand == 1 ? u1 : sigBand == 2 ? u2 : u3
float lK = sigBand == 1 ? l1 : sigBand == 2 ? l2 : l3
bool shortRej = inSess and barsIn > 2 and high >= uK and close < uK and close < open
bool longRej  = inSess and barsIn > 2 and low <= lK and close > lK and close > open
plotshape(showSig and shortRej, "Upper band rejection", shape.triangledown, location.abovebar, cU3, size = size.tiny)
plotshape(showSig and longRej, "Lower band rejection", shape.triangleup, location.belowbar, cL3, size = size.tiny)

// ════════════════════════════ ALERTS ════════════════════════════
// v6 'and' is lazy — compute ta.* crosses unconditionally every bar
bool xUpVW = ta.crossover(close, vw)
bool xDnVW = ta.crossunder(close, vw)
bool xPVW  = ta.cross(close, pVW)
alertcondition(newSess, "Session VWAP reset", "{{ticker}} σ-VWAP session reset")
alertcondition(inSess and xUpVW, "Price reclaims VWAP", "{{ticker}} reclaimed session VWAP @ {{close}}")
alertcondition(inSess and xDnVW, "Price loses VWAP", "{{ticker}} lost session VWAP @ {{close}}")
alertcondition(inSess and high >= u2 and high[1] < u2[1], "Tag Upper 2", "{{ticker}} tagged upper band 2 @ {{close}}")
alertcondition(inSess and low <= l2 and low[1] > l2[1], "Tag Lower 2", "{{ticker}} tagged lower band 2 @ {{close}}")
alertcondition(inSess and high >= u3 and high[1] < u3[1], "Tag Upper 3", "{{ticker}} tagged upper band 3 (extreme) @ {{close}}")
alertcondition(inSess and low <= l3 and low[1] > l3[1], "Tag Lower 3", "{{ticker}} tagged lower band 3 (extreme) @ {{close}}")
alertcondition(shortRej, "Upper band rejection", "{{ticker}} upper band rejection @ {{close}}")
alertcondition(longRej, "Lower band rejection", "{{ticker}} lower band rejection @ {{close}}")
alertcondition(inSess and not na(pVW) and xPVW, "Cross prior VWAP", "{{ticker}} crossed prior-session VWAP @ {{close}}")

// ════════════════════════════ RIGHT-EDGE LABELS ════════════════════════════
string tag = bandMd == "Std Dev" ? "σ" : "×"
var label[] lbls = array.new<label>()
if barstate.islast
    if lbls.size() == 0
        for i = 0 to 6
            lbls.push(label.new(bar_index, close, "", color = color(na), style = label.style_label_left, size = size.small))
    float[]  lv = array.from(u3, u2, u1, pv, l1, l2, l3)
    string[] tx = array.from("+" + str.tostring(m3) + tag, "+" + str.tostring(m2) + tag, "+" + str.tostring(m1) + tag, "VWAP", "-" + str.tostring(m1) + tag, "-" + str.tostring(m2) + tag, "-" + str.tostring(m3) + tag)
    color[]  cl = array.from(cU3, cU2, cU1, vCol, cL1, cL2, cL3)
    for i = 0 to 6
        label lb = lbls.get(i)
        float y = lv.get(i)
        bool ok = showLbl and not na(y)
        lb.set_xy(bar_index + 3, ok ? y : close)
        lb.set_text(ok ? tx.get(i) + "  " + str.tostring(y, format.mintick) : "")
        lb.set_textcolor(cl.get(i))

// ════════════════════════════ DASHBOARD ════════════════════════════
string tPos = switch tPosIn
    "Top right"    => position.top_right
    "Bottom right" => position.bottom_right
    "Top left"     => position.top_left
    => position.bottom_left
var table tb = table.new(tPos, 2, 8, bgcolor = color.new(#0B1220, 8), border_color = color.new(#334155, 0), border_width = 1)

f_row(int r, string k, string v, color c) =>
    table.cell(tb, 0, r, k, text_color = color.new(#94A3B8, 0), text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_right)

if showTbl and barstate.islast
    string zone = na(z) ? "out of session" : z >= m3 ? "≥ +3 · extreme" : z >= m2 ? "+2→+3 · stretched" : z >= m1 ? "+1→+2 · trend" : z > -m1 ? "±1 · value" : z > -m2 ? "−1→−2 · trend" : z > -m3 ? "−2→−3 · stretched" : "≤ −3 · extreme"
    string bias = vCol == cBull ? "BULL" : vCol == cBear ? "BEAR" : "ROTATION"
    table.cell(tb, 0, 0, "σ-VWAP", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 0, sessStr + "  " + tzStr, text_color = color.new(#94A3B8, 0), text_size = size.tiny)
    f_row(1, "VWAP", na(pv) ? "—" : str.tostring(pv, format.mintick), vCol)
    f_row(2, "Bias", bias, vCol)
    f_row(3, "1" + tag + " (pts)", na(unit) ? "—" : str.tostring(unit, format.mintick), color.white)
    f_row(4, "Now", na(z) ? "—" : (z >= 0 ? "+" : "") + str.tostring(z, "#.00") + tag, zCol)
    f_row(5, "Zone", zone, zCol)
    f_row(6, "Session ext", na(zHi) ? "—" : str.tostring(zLo, "#.0") + " / +" + str.tostring(zHi, "#.0") + tag, color.white)
    f_row(7, "Mode", (ltfActive ? "Intrabar " + ltf : "Chart bars") + (timeframe.isdwm ? " · USE INTRADAY TF" : ""), timeframe.isdwm ? cBear : color.new(#94A3B8, 0))
