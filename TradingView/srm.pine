grpVS = "Vol-Step Ranges (inspired by LuxAlgo Predictive Ranges)"
vsOn     = input.bool(true, "Show Vol-Step Ranges", group = grpVS)
vsSource = input.string("Implied move (VXN)", "Step size from", options = ["Implied move (VXN)", "ATR (classic)"], group = grpVS)
vsMult   = input.float(0.5, "Step = × daily expected move (implied mode)", step = 0.05, minval = 0.05, group = grpVS)
vsAtrLen = input.int(200, "ATR length (classic mode)", minval = 2, group = grpVS)
vsAtrFac = input.float(6.0, "ATR factor (classic mode)", step = 0.5, minval = 0.5, group = grpVS)
vsFill   = input.int(92, "Band fill transparency", minval = 0, maxval = 100, group = grpVS)

grpC = "Colors"
cAsia    = input.color(#7D8A99, "Asia",   inline = "s", group = grpC)
cLon     = input.color(#C8794A, "London", inline = "s", group = grpC)
