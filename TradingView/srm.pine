moLiveProf = input.bool(true, "Show developing monthly profile", group = grpM)
moProfPos  = input.string("Right edge", "Developing monthly profile position", options = ["Right edge", "Month start"], group = grpM)
moRightOff = input.int(150, "Right-edge profile offset (bars)", minval = 0, maxval = 450, group = grpM)
