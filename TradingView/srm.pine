moPrevVa   = input.bool(true, "Carry prior-month POC / VAH / VAL through the whole month (even after touched)", group = grpM)

grpA = "Alerts (create one alert → condition: Any alert() function call)"
alBudget    = input.bool(true,  "Range budget spent (session / week / month)", group = grpA)
