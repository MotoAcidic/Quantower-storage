//@version=6
// Session Range Map v9 (release candidate) — NY initial balance · adaptive (time-aware) completion projection · v7 math audit: fresh VXN, recalibrated budgets (2-yr NQ), finer profile math (Ocean palette: charcoal · copper · teal · silver; avoids GEX red/green/yellow and your purple QQQ / cyan dark-pool colors) — Asia / London / New York + Weekly + Monthly layers · alerts · per-layer label switches · Vol-Step Ranges
// Vol-Step Ranges: idea inspired by LuxAlgo's "Predictive Ranges" (CC BY-NC-SA 4.0); independent implementation, not their code.
// Range budgets · completion projections · session volume profiles (POC / VAH / VAL) · naked levels · labels · full color control
// A range MAP, not a signal tool. Evidence for the defaults is at the bottom.
indicator("Session Range Map", "SRM", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

string TZ = "America/New_York"

// ═════════════ Inputs ═════════════
grpV = "Volatility source"
volSym  = input.symbol("CBOE:VXN",   "Implied vol index (VXN for NQ/MNQ/QQQ · VIX for ES/MES/SPY)", group = grpV)
vixSym  = input.symbol("CBOE:VIX",   "VIX",   group = grpV)
vix3Sym = input.symbol("CBOE:VIX3M", "VIX3M", group = grpV)

grpS = "Sessions (New York time) · budget = share of daily expected move"
asiaOn    = input.bool(true, "Asia",   inline = "a", group = grpS)
asiaSes   = input.session("1800-0300", "", inline = "a", group = grpS)
asiaShare = input.float(0.43, "×", step = 0.01, inline = "a", group = grpS)
lonOn     = input.bool(true, "London", inline = "l", group = grpS)
lonSes    = input.session("0300-0930", "", inline = "l", group = grpS)
lonShare  = input.float(0.48, "×", step = 0.01, inline = "l", group = grpS)
nyOn      = input.bool(true, "NY",     inline = "n", group = grpS)
nySes     = input.session("0930-1600", "", inline = "n", group = grpS)
nyShare   = input.float(0.90, "×", step = 0.01, inline = "n", group = grpS)
kProj     = input.float(1.3, "Completion projection (× session budget)", step = 0.1, group = grpS)
projMode  = input.string("Adaptive", "Projection mode", options = ["Adaptive", "Fixed"], group = grpS, tooltip = "Adaptive = max(fixed line, current extreme + remaining-extension allowance that shrinks as the period elapses). Never sits inside the range. Out-of-sample coverage: sessions 81–90% vs 70–80% fixed; week 84% vs 79%; month 88% vs 82%.")
extMult   = input.float(1.0, "Adaptive allowance multiplier (1.0 = calibrated 85th pct per side)", step = 0.05, minval = 0.1, group = grpS)
expScale    = input.bool(true, "Widen all budgets in EXPANDED regime (VIX ≥ VIX3M)", group = grpS)
expMult     = input.float(1.39, "EXPANDED budget multiplier (NQ: 1.56× vs 1.12× median day)", step = 0.01, group = grpS)
showBudget  = input.bool(true, "Show budget band", group = grpS)
budgetStyle = input.string("Dashed", "Budget line style", options = ["Solid", "Dashed", "Dotted"], group = grpS)
budgetWidth = input.int(1, "Budget line width", minval = 1, maxval = 4, group = grpS)
showProj    = input.bool(true, "Show completion projection", group = grpS)
projStyle   = input.string("Dotted", "Projection line style", options = ["Solid", "Dashed", "Dotted"], group = grpS)
projWidth   = input.int(2, "Projection line width", minval = 1, maxval = 4, group = grpS)
showPastBands = input.bool(false, "Keep past session budget bands", group = grpS)
ibOn      = input.bool(true, "NY initial balance (first-hour high / low)", group = grpS, tooltip = "One side of the NY first hour holds as the session extreme ~80% of days (QQQ 720 sessions: 79%; NQ 50 sessions: 82%).")
ibMinutes = input.int(60, "Initial balance length (minutes)", minval = 5, maxval = 180, group = grpS)
ibKeep    = input.bool(false, "Keep past initial balances", group = grpS)

grpP = "Session volume profiles"
showProf      = input.bool(true, "Show session profiles", group = grpP)
rowsPerBudget = input.int(48, "Session profile math resolution (rows per budget)", minval = 6, maxval = 200, group = grpP)
wkRows        = input.int(96, "Weekly profile math resolution (rows per budget)", minval = 12, maxval = 300, group = grpP)
moRows        = input.int(160, "Monthly profile math resolution (rows per budget)", minval = 12, maxval = 400, group = grpP)
profMaxRows   = input.int(40, "Max drawn rows per profile (display only; math stays fine)", minval = 10, maxval = 120, group = grpP)
profWidth     = input.float(0.35, "Profile width (fraction of session)", minval = 0.05, maxval = 1.0, step = 0.05, group = grpP)
vaPct         = input.float(70, "Value area %", minval = 50, maxval = 95, group = grpP)
keepProfiles  = input.int(9, "Keep last N session profiles", minval = 1, maxval = 30, group = grpP)
showPocVa     = input.bool(true, "Draw POC / VAH / VAL lines inside each session", group = grpP)
nakedPoc      = input.bool(true, "Extend naked POCs until touched", group = grpP)
nakedVa       = input.bool(false, "Extend naked VAH / VAL until touched", group = grpP)
vaStyle       = input.string("Dashed", "VAH / VAL line style", options = ["Solid", "Dashed", "Dotted"], group = grpP)
pocWidth      = input.int(2, "POC line width", minval = 1, maxval = 4, group = grpP)

grpL = "Levels"
showPD      = input.bool(true, "Prior day high / low / close", group = grpL)
showPW      = input.bool(true, "Prior week high / low", group = grpL)
