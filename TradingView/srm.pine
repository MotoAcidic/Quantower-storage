nakedMax    = input.int(150, "Max naked levels kept", minval = 10, maxval = 300, group = grpL)
nakedRange  = input.float(2.5, "Label naked levels within (× daily expected move)", step = 0.5, group = grpL)
nearestN    = input.int(4, "Label nearest N level groups above and below price", minval = 1, maxval = 15, group = grpL)
mergeTol    = input.float(0.03, "Merge labels closer than (× daily expected move)", step = 0.01, group = grpL)

grpLb = "Labels"
showLabels     = input.bool(true, "Show labels on lines", group = grpLb)
labelSize      = input.string("Small", "Label size", options = ["Tiny", "Small", "Normal"], group = grpLb)
labelLineColor = input.bool(true, "Color each label like its line", group = grpLb)
cLabel         = input.color(#C9CED6, "Label color (when not line-colored)", group = grpLb)
labelOffset    = input.int(3, "Right-edge label offset (bars)", minval = 0, maxval = 50, group = grpLb)
labSess        = input.bool(true, "Session labels (budget, projection, live POC/VA)", group = grpLb)
labNaked       = input.bool(true, "Naked session level labels", group = grpLb)
labWk          = input.bool(true, "Weekly labels", group = grpLb)
labMo          = input.bool(true, "Monthly labels", group = grpLb)
labCtx         = input.bool(true, "Prior day / week labels", group = grpLb)
labVs          = input.bool(true, "Vol-Step Range labels", group = grpLb)

grpW = "Weekly layer"
wkOn       = input.bool(true, "Show weekly layer", group = grpW)
wkMult     = input.float(1.22, "Weekly budget (× weekly expected move = daily × √5) · median NQ week = 1.22", step = 0.05, group = grpW)
wkKProj    = input.float(1.3, "Weekly completion projection (× weekly budget)", step = 0.1, group = grpW)
wkBudget   = input.bool(true, "Show weekly budget band", group = grpW)
wkProjOn   = input.bool(true, "Show weekly completion projection", group = grpW)
wkProfOn   = input.bool(true, "Draw finished weekly profiles", group = grpW)
wkKeep     = input.int(2, "Keep last N weekly profiles", minval = 1, maxval = 10, group = grpW)
wkPocVa    = input.bool(true, "Draw weekly POC / VAH / VAL inside each week", group = grpW)
wkNakedPoc = input.bool(true, "Extend naked weekly POCs until touched", group = grpW)
wkNakedVa  = input.bool(true, "Extend naked weekly VAH / VAL until touched", group = grpW)
wkNakedHL  = input.bool(true, "Extend naked weekly highs / lows until touched", group = grpW)
wkWidth    = input.int(2, "Weekly line width", minval = 1, maxval = 4, group = grpW)
wkLiveProf = input.bool(true, "Show developing weekly profile", group = grpW)
wkProfPos  = input.string("Right edge", "Developing weekly profile position", options = ["Right edge", "Week start"], group = grpW)
wkRightOff = input.int(60, "Right-edge profile offset (bars)", minval = 0, maxval = 400, group = grpW)
wkRightW   = input.int(80, "Right-edge profile width (bars)", minval = 10, maxval = 400, group = grpW)
wkPrevVa   = input.bool(true, "Carry prior-week POC / VAH / VAL through the whole week (even after touched)", group = grpW)

grpM = "Monthly layer"
moOn       = input.bool(true, "Show monthly layer", group = grpM)
moMult     = input.float(1.34, "Monthly budget (× monthly expected move = daily × √21) · median NQ month = 1.34", step = 0.05, group = grpM)
moKProj    = input.float(1.3, "Monthly completion projection (× monthly budget)", step = 0.1, group = grpM)
moBudget   = input.bool(true, "Show monthly budget band", group = grpM)
moProjOn   = input.bool(true, "Show monthly completion projection", group = grpM)
moProfOn   = input.bool(true, "Draw finished monthly profiles", group = grpM)
moKeep     = input.int(1, "Keep last N monthly profiles", minval = 1, maxval = 6, group = grpM)
moPocVa    = input.bool(true, "Draw monthly POC / VAH / VAL inside each month", group = grpM)
moNakedPoc = input.bool(true, "Extend naked monthly POCs until touched", group = grpM)
moNakedVa  = input.bool(true, "Extend naked monthly VAH / VAL until touched", group = grpM)
