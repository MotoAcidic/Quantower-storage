<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>test</AssemblyName>
    <RootNamespace>OceansPivotDecoder.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!--
    The math, the session scan, the caller parser and the log writer are all free of ATAS types
    precisely so they can be exercised here, on synthetic bars, where the arithmetic can actually
    be checked. Only the rendering and the settings live on the other side of the line.
  -->
  <ItemGroup>
    <Compile Include="../PivotDecoderMath.cs" />
    <Compile Include="../PivotDecoderLog.cs" />
    <Compile Include="../PivotDecoderProfile.cs" />
    <Compile Include="../PivotDecoderZones.cs" />
    <Compile Include="../PivotDecoderAbsorption.cs" />
    <Compile Include="../PivotDecoderStats.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
