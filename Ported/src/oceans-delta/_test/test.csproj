<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>test</AssemblyName>
    <RootNamespace>OceansDelta.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!--
    The model carries no ATAS types, so it runs here against references that share none of its
    code. Only the reading of candles and the drawing need the platform.
  -->
  <ItemGroup>
    <Compile Include="../DeltaMath.cs" />
    <Compile Include="../Icebergs.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
