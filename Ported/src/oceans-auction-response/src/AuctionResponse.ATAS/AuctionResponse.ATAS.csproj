<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <AssemblyName>AuctionResponseMonitor</AssemblyName>
    <RootNamespace>AuctionResponse.Atas</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AtasDir>C:\Program Files (x86)\ATAS Platform</AtasDir>
  </PropertyGroup>

  <!-- Core and Replay ship alongside the indicator; ATAS assemblies come from the host. -->
  <ItemGroup>
    <ProjectReference Include="..\AuctionResponse.Core\AuctionResponse.Core.csproj" />
    <ProjectReference Include="..\AuctionResponse.Replay\AuctionResponse.Replay.csproj" />
    <ProjectReference Include="..\AuctionResponse.Ui\AuctionResponse.Ui.csproj" />
    <ProjectReference Include="..\AuctionResponse.Research\AuctionResponse.Research.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ATAS.Indicators"><HintPath>$(AtasDir)\ATAS.Indicators.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ATAS.DataFeedsCore"><HintPath>$(AtasDir)\ATAS.DataFeedsCore.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ATAS.Types"><HintPath>$(AtasDir)\ATAS.Types.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="OFT.Attributes"><HintPath>$(AtasDir)\OFT.Attributes.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="OFT.Core"><HintPath>$(AtasDir)\OFT.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="OFT.Localization"><HintPath>$(AtasDir)\OFT.Localization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="OFT.Rendering"><HintPath>$(AtasDir)\OFT.Rendering.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Utils.Common"><HintPath>$(AtasDir)\Utils.Common.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
