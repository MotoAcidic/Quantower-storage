<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>test</AssemblyName>
    <RootNamespace>OceansRead.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!--
    Every one of these carries no ATAS type, which is why they are in their own files: the
    whole read can be exercised here against references that share none of its code. Only the
    rendering needs the platform.
  -->
  <ItemGroup>
    <Compile Include="../ReadClock.cs" />
    <Compile Include="../ProfileMath.cs" />
    <Compile Include="../RhythmMath.cs" />
    <Compile Include="../AuctionMath.cs" />
    <Compile Include="../AcceptanceMath.cs" />
    <Compile Include="../WaveMath.cs" />
    <Compile Include="../VwapMath.cs" />
    <Compile Include="../OrderflowMath.cs" />
    <Compile Include="../ReadModel.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
