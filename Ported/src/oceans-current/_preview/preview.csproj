<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Renders the real panel code into a PNG through ATAS's own GDI+ RenderContext, outside ATAS.
    Every change to the panel used to cost a platform restart to see; this costs a second.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <AssemblyName>preview</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AtasDir>C:\Program Files (x86)\ATAS Platform</AtasDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <ProjectReference Include="../OceansCurrent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ATAS.Indicators"><HintPath>$(AtasDir)\ATAS.Indicators.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="OFT.Rendering"><HintPath>$(AtasDir)\OFT.Rendering.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Rendering.GDIPlus"><HintPath>$(AtasDir)\Rendering.GDIPlus.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="OFT.Attributes"><HintPath>$(AtasDir)\OFT.Attributes.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="OFT.Core"><HintPath>$(AtasDir)\OFT.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Utils.Common"><HintPath>$(AtasDir)\Utils.Common.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
