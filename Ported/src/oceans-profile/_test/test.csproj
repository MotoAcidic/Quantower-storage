<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>test</AssemblyName>
    <RootNamespace>OceansProfile.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!--
    The profile maths and the period cutting carry no ATAS types, so they run here against
    references that share none of their code. Only the rendering needs the platform.
  -->
  <ItemGroup>
    <Compile Include="../ProfileMath.cs" />
    <Compile Include="../PeriodClock.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
