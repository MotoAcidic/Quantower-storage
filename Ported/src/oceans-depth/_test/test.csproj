<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>test</AssemblyName>
    <RootNamespace>OceansDepth.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!--
    The bucketing, the fade and the gradient carry no ATAS types, so they can be driven here
    against references that share none of their code. Everything that needs a live book stays
    in the indicator and is checked in ATAS instead.
  -->
  <ItemGroup>
    <Compile Include="../DepthMath.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
